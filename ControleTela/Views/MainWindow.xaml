<ui:FluentWindow x:Class="ControleTela.Views.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:views="clr-namespace:ControleTela.Views"
                 xmlns:vm="clr-namespace:ControleTela.ViewModels"
                 xmlns:models="clr-namespace:ControleTela.Models;assembly=ControleTela.Core"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance vm:MainViewModel}"
                 Title="Monitor Router" Width="980" Height="900" MinWidth="720" MinHeight="520"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" WindowCornerPreference="Round"
                 FontFamily="Segoe UI Variable Text, Segoe UI">

    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- Estilos reutilizáveis: definidos uma vez, usados em todos os cartões. -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,28,0,8" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
        <Style x:Key="CardDescription" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="ValueText" TargetType="TextBlock">
            <Setter Property="Width" Value="60" />
            <Setter Property="Margin" Value="12,0,0,0" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
        <!-- BasedOn mantém o visual Fluent do WPF-UI; só mudamos largura e o "encaixe" em passos. -->
        <Style TargetType="Slider" BasedOn="{StaticResource {x:Type Slider}}">
            <Setter Property="Width" Value="240" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="IsSnapToTickEnabled" Value="True" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
        </Style>
        <Style x:Key="CardSpacing" TargetType="ui:CardControl" BasedOn="{StaticResource {x:Type ui:CardControl}}">
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Monitor Router">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/app.png" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="40,4,40,40" MaxWidth="1000">

                <!-- Breadcrumb: "Tela  >  Tela 2 - ..." -->
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Tela" FontSize="28" FontWeight="SemiBold"
                               FontFamily="Segoe UI Variable Display, Segoe UI"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ui:SymbolIcon Symbol="ChevronRight24" FontSize="20" Margin="14,6,14,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{Binding SelectedMonitor.DisplayName, FallbackValue='Nenhum monitor'}"
                               FontSize="28" FontWeight="SemiBold"
                               FontFamily="Segoe UI Variable Display, Segoe UI"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                </StackPanel>
                <TextBlock Margin="0,16,0,12" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           Text="Selecione um vídeo para ajustar cor, brilho e contraste somente dele." />

                <!-- Avisos -->
                <ui:InfoBar Margin="0,0,0,8" Severity="Warning" IsClosable="True"
                            IsOpen="{Binding IsNightLightOn, Mode=TwoWay}"
                            Title="A Luz noturna está ativada"
                            Message="Ela usa a mesma tabela de cores que este app e pode desfazer ou misturar os ajustes. Desative-a em Configurações > Sistema > Tela. O mesmo vale para o f.lux e o painel de cor da NVIDIA/AMD." />
                <ui:InfoBar Margin="0,0,0,8" Severity="Warning" IsClosable="False"
                            IsOpen="{Binding SelectedMonitor.IsHdr, Mode=OneWay, FallbackValue=False}"
                            Title="HDR ativado neste monitor"
                            Message="Com HDR ligado, o Windows controla a cor por outro caminho e os ajustes podem não ter efeito." />
                <ui:InfoBar Margin="0,0,0,8" IsClosable="True"
                            IsOpen="{Binding IsStatusOpen, Mode=TwoWay}"
                            Severity="{Binding StatusSeverity}"
                            Title="{Binding StatusTitle}"
                            Message="{Binding StatusMessage}" />

                <!-- Mapa dos monitores -->
                <Border CornerRadius="8" BorderThickness="1" Padding="16"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <views:MonitorMapControl Height="230"
                                                 Monitors="{Binding Monitors}"
                                                 SelectedMonitor="{Binding SelectedMonitor, Mode=TwoWay}" />
                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                            <ui:Button Content="Detectar" MinWidth="110" Margin="0,0,8,0"
                                       Icon="{ui:SymbolIcon ArrowSync24}"
                                       ToolTip="Procura monitores novamente"
                                       Command="{Binding RefreshMonitorsCommand}" />
                            <ui:Button Content="Identificar" MinWidth="130"
                                       Icon="{ui:SymbolIcon NumberSymbol24}"
                                       Click="Identify_Click" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ======== Controles do monitor selecionado (DataContext = SelectedMonitor) ======== -->
                <StackPanel DataContext="{Binding SelectedMonitor}"
                            Visibility="{Binding DataContext.HasSelection, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}">

                    <ui:CardControl Margin="0,4,0,0" Icon="{ui:SymbolIcon Desktop24}">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="{Binding DisplayName}" />
                                <TextBlock Style="{StaticResource CardDescription}" Text="{Binding Details}" />
                            </StackPanel>
                        </ui:CardControl.Header>
                    </ui:CardControl>

                    <TextBlock Style="{StaticResource SectionHeader}" Text="Brilho e contraste" />

                    <ui:CardControl Style="{StaticResource CardSpacing}" Icon="{ui:SymbolIcon BrightnessHigh24}">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="Brilho" />
                                <TextBlock Style="{StaticResource CardDescription}" Text="Clareia ou escurece toda a imagem" />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <StackPanel Orientation="Horizontal">
                            <Slider Minimum="{x:Static models:ColorSettings.BrightnessMin}"
                                    Maximum="{x:Static models:ColorSettings.BrightnessMax}"
                                    TickFrequency="0.01" SmallChange="0.01" LargeChange="0.05"
                                    Value="{Binding Brightness}" />
                            <TextBlock Style="{StaticResource ValueText}" Text="{Binding Brightness, StringFormat={}{0:+0%;-0%;0%}}" />
                        </StackPanel>
                    </ui:CardControl>

                    <ui:CardControl Style="{StaticResource CardSpacing}" Icon="{ui:SymbolIcon DarkTheme24}">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="Contraste" />
                                <TextBlock Style="{StaticResource CardDescription}" Text="Diferença entre as áreas claras e escuras" />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <StackPanel Orientation="Horizontal">
                            <Slider Minimum="{x:Static models:ColorSettings.ContrastMin}"
                                    Maximum="{x:Static models:ColorSettings.ContrastMax}"
                                    TickFrequency="0.01" SmallChange="0.01" LargeChange="0.05"
                                    Value="{Binding Contrast}" />
                            <TextBlock Style="{StaticResource ValueText}" Text="{Binding Contrast, StringFormat={}{0:0%}}" />
                        </StackPanel>
                    </ui:CardControl>

                    <ui:CardControl Style="{StaticResource CardSpacing}" Icon="{ui:SymbolIcon DataLine24}">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="Gama" />
                                <TextBlock Style="{StaticResource CardDescription}" Text="Valores maiores clareiam os tons médios sem estourar o branco" />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <StackPanel Orientation="Horizontal">
                            <Slider Minimum="{x:Static models:ColorSettings.GammaMin}"
                                    Maximum="{x:Static models:ColorSettings.GammaMax}"
                                    TickFrequency="0.01" SmallChange="0.01" LargeChange="0.1"
                                    Value="{Binding Gamma}" />
                            <TextBlock Style="{StaticResource ValueText}" Text="{Binding Gamma, StringFormat={}{0:0.00}}" />
                        </StackPanel>
                    </ui:CardControl>

                    <TextBlock Style="{StaticResource SectionHeader}" Text="Cor" />

                    <ui:CardControl Style="{StaticResource CardSpacing}" Icon="{ui:SymbolIcon Color24}">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="10" Height="10" Fill="#FFE5484D" Margin="0,1,8,0" />
                                    <TextBlock Style="{StaticResource CardTitle}" Text="Vermelho" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource CardDescription}" Text="Intensidade do canal vermelho" />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <StackPanel Orientation="Horizontal">
                            <Slider Minimum="{x:Static models:ColorSettings.GainMin}"
                                    Maximum="{x:Static models:ColorSettings.GainMax}"
                                    TickFrequency="0.01" SmallChange="0.01" LargeChange="0.05"
                                    Value="{Binding Red}" />
                            <TextBlock Style="{StaticResource ValueText}" Text="{Binding Red, StringFormat={}{0:0%}}" />
                        </StackPanel>
                    </ui:CardControl>

                    <ui:CardControl Style="{StaticResource CardSpacing}" Icon="{ui:SymbolIcon Color24}">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="10" Height="10" Fill="#FF30A46C" Margin="0,1,8,0" />
                                    <TextBlock Style="{StaticResource CardTitle}" Text="Verde" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource CardDescription}" Text="Intensidade do canal verde" />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <StackPanel Orientation="Horizontal">
                            <Slider Minimum="{x:Static models:ColorSettings.GainMin}"
                                    Maximum="{x:Static models:ColorSettings.GainMax}"
                                    TickFrequency="0.01" SmallChange="0.01" LargeChange="0.05"
                                    Value="{Binding Green}" />
                            <TextBlock Style="{StaticResource ValueText}" Text="{Binding Green, StringFormat={}{0:0%}}" />
                        </StackPanel>
                    </ui:CardControl>

                    <ui:CardControl Style="{StaticResource CardSpacing}" Icon="{ui:SymbolIcon Color24}">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="10" Height="10" Fill="#FF3E83F8" Margin="0,1,8,0" />
                                    <TextBlock Style="{StaticResource CardTitle}" Text="Azul" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource CardDescription}" Text="Intensidade do canal azul" />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <StackPanel Orientation="Horizontal">
                            <Slider Minimum="{x:Static models:ColorSettings.GainMin}"
                                    Maximum="{x:Static models:ColorSettings.GainMax}"
                                    TickFrequency="0.01" SmallChange="0.01" LargeChange="0.05"
                                    Value="{Binding Blue}" />
                            <TextBlock Style="{StaticResource ValueText}" Text="{Binding Blue, StringFormat={}{0:0%}}" />
                        </StackPanel>
                    </ui:CardControl>

                    <ui:CardControl Style="{StaticResource CardSpacing}" Icon="{ui:SymbolIcon Temperature24}">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="Temperatura de cor" />
                                <TextBlock Style="{StaticResource CardDescription}" Text="6500 K é neutro; valores menores deixam a imagem mais quente (alaranjada)" />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <StackPanel Orientation="Horizontal">
                            <Slider Minimum="{x:Static models:ColorSettings.TemperatureMin}"
                                    Maximum="{x:Static models:ColorSettings.TemperatureMax}"
                                    TickFrequency="100" SmallChange="100" LargeChange="500"
                                    Value="{Binding Temperature}" />
                            <TextBlock Style="{StaticResource ValueText}" Text="{Binding Temperature, StringFormat={}{0:0} K}" />
                        </StackPanel>
                    </ui:CardControl>
                </StackPanel>

                <!-- ======== Ações (DataContext = MainViewModel) ======== -->
                <TextBlock Style="{StaticResource SectionHeader}" Text="Ações" />

                <ui:CardControl Style="{StaticResource CardSpacing}" Icon="{ui:SymbolIcon ArrowReset24}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="Redefinir" />
                            <TextBlock Style="{StaticResource CardDescription}" Text="Volta às cores originais do Windows" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <StackPanel Orientation="Horizontal">
                        <ui:Button Content="Redefinir" MinWidth="110" Margin="0,0,8,0" Command="{Binding ResetCommand}" />
                        <ui:Button Content="Redefinir todos" MinWidth="130" Command="{Binding ResetAllCommand}" />
                    </StackPanel>
                </ui:CardControl>

                <ui:CardControl Style="{StaticResource CardSpacing}" Icon="{ui:SymbolIcon Copy24}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="Copiar configuração" />
                            <TextBlock Style="{StaticResource CardDescription}"
                                       Text="{Binding SelectedMonitor.DisplayName, StringFormat='Copia os ajustes da {0} para outro monitor'}" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <StackPanel Orientation="Horizontal">
                        <ComboBox Width="230" Margin="0,0,8,0"
                                  ItemsSource="{Binding CopyTargets}" DisplayMemberPath="Name"
                                  SelectedItem="{Binding SelectedCopyTarget}" />
                        <ui:Button Content="Copiar" MinWidth="100" Appearance="Primary"
                                   Icon="{ui:SymbolIcon Copy24}" Command="{Binding CopySettingsCommand}" />
                    </StackPanel>
                </ui:CardControl>

                <!-- ======== Perfis ======== -->
                <TextBlock Style="{StaticResource SectionHeader}" Text="Perfis" />

                <ui:CardControl Style="{StaticResource CardSpacing}" Icon="{ui:SymbolIcon FolderOpen24}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="Carregar perfil" />
                            <TextBlock Style="{StaticResource CardDescription}" Text="Aplica os ajustes salvos em todos os monitores" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <StackPanel Orientation="Horizontal">
                        <ComboBox Width="190" Margin="0,0,8,0"
                                  ItemsSource="{Binding PresetNames}" SelectedItem="{Binding SelectedPreset}" />
                        <ui:Button Content="Carregar" MinWidth="100" Margin="0,0,8,0" Appearance="Primary"
                                   Command="{Binding LoadPresetCommand}" />
                        <ui:Button Icon="{ui:SymbolIcon Delete24}" ToolTip="Excluir perfil"
                                   Command="{Binding DeletePresetCommand}" />
                    </StackPanel>
                </ui:CardControl>

                <ui:CardControl Style="{StaticResource CardSpacing}" Icon="{ui:SymbolIcon Save24}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="Salvar perfil" />
                            <TextBlock Style="{StaticResource CardDescription}" Text="Guarda a configuração atual de todos os monitores (mesmo nome substitui)" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <StackPanel Orientation="Horizontal">
                        <ui:TextBox Width="190" Margin="0,0,8,0" PlaceholderText="Ex.: Jogo, Leitura, Noite"
                                    Text="{Binding NewPresetName, UpdateSourceTrigger=PropertyChanged}" />
                        <ui:Button Content="Salvar" MinWidth="100" Icon="{ui:SymbolIcon Save24}"
                                   Command="{Binding SavePresetCommand}" />
                    </StackPanel>
                </ui:CardControl>

                <!-- ======== Aplicativo ======== -->
                <TextBlock Style="{StaticResource SectionHeader}" Text="Aplicativo" />

                <ui:CardControl Style="{StaticResource CardSpacing}" Icon="{ui:SymbolIcon Power24}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="Iniciar com o Windows" />
                            <TextBlock Style="{StaticResource CardDescription}" Text="Abre minimizado na bandeja e reaplica os últimos ajustes" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:ToggleSwitch IsChecked="{Binding StartWithWindows}" />
                </ui:CardControl>

                <ui:CardControl Style="{StaticResource CardSpacing}" Icon="{ui:SymbolIcon Info24}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="Como os ajustes ficam ativos" />
                            <TextBlock Style="{StaticResource CardDescription}"
                                       Text="Minimizar mantém tudo aplicado (o app fica na bandeja, perto do relógio). Fechar devolve as cores originais a todas as telas. Luz noturna, f.lux e os painéis da NVIDIA/AMD usam a mesma tabela e podem conflitar." />
                        </StackPanel>
                    </ui:CardControl.Header>
                </ui:CardControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</ui:FluentWindow>
