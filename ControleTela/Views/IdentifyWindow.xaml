<Window x:Class="ControleTela.Views.IdentifyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight" Left="-10000" Top="-10000" Opacity="0">
    <!-- Começa invisível e fora da tela; o código posiciona no monitor certo e só então mostra. -->
    <Border Width="170" Height="170" CornerRadius="12" Background="#F0202020"
            BorderThickness="2" x:Name="Frame">
        <TextBlock x:Name="NumberText" FontSize="110" FontWeight="SemiBold" Foreground="White"
                   FontFamily="Segoe UI Variable Display, Segoe UI"
                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-12,0,0" />
    </Border>
</Window>
