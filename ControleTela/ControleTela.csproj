<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Só para o ícone da bandeja (NotifyIcon), que o WPF não tem. -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ControleTela</RootNamespace>
    <AssemblyName>MonitorRouter</AssemblyName>
    <Product>Monitor Router</Product>
    <AssemblyTitle>Monitor Router</AssemblyTitle>
    <Description>Ajusta cor, brilho, contraste e gama de cada monitor</Description>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <!-- Evita conflitos de nomes (Application, Button...) entre WinForms e WPF. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="4.3.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ControleTela.Core\ControleTela.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.png" />
    <Content Include="Assets\app.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
